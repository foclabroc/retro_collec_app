# À ajouter dans le Caddyfile existant (à côté du bloc Jellyfin).
# Remplacer api.mondomaine.fr par le sous-domaine choisi (DNS vers la box, ports 80/443 ouverts).

api.mondomaine.fr {
	encode gzip

	# RPC : /rest/v1/rpc/rc_… → PostgREST, clé publique de l'appli obligatoire
	# (sauf pré-requêtes CORS). Le contrôle doit être DANS le handle_path :
	# Caddy traite handle_path avant un respond placé au niveau du site.
	handle_path /rest/v1/* {
		@sanscle {
			not method OPTIONS
			not header apikey sb_publishable_M1Rdee-lSEzCfq81zjYq5Q_NgJ0a35z
		}
		respond @sanscle 401
		reverse_proxy 127.0.0.1:3000
	}

	# Temps réel (WebSocket des duels) → relais rc-realtime
	handle /realtime/* {
		reverse_proxy 127.0.0.1:4000
	}

	respond 404
}
